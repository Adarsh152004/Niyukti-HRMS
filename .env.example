# ==============================================================================
# NIYUKTI HRMS Intelligence OS — Complete Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root:
#    cp .env.example .env   (Linux/macOS) OR copy .env.example .env (Windows)
# 2. Fill in your valid API keys and connection credentials below.
# 3. DO NOT commit your real '.env' file to Git.
# ==============================================================================

# ── 1. Core Server & Runtime Settings ───────────────────────────────────────────
APP_NAME="HRMS Intelligence OS"
APP_VERSION="22.0.0"
APP_ENV="development"                  # options: 'development', 'production'
PORT=8000                              # FastAPI backend port (default: 8000)
SECRET_KEY="enterprise_hrms_super_secret_production_key_2026"
TENANT_ID="org-apex-01"

# ── 2. Primary Database Configuration ──────────────────────────────────────────
# Default: Local SQLite (zero setup required for rapid development)
DATABASE_URL="sqlite+aiosqlite:///./hrms.db"
DATABASE_ENABLED=true
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Alternative: PostgreSQL 16 + pgvector (Production)
# DATABASE_URL="postgresql+asyncpg://hrms_user:hrms_pass@localhost:5432/hrms_db"

# ── 3. Redis Cache & Rate Limiter (Optional / Docker) ──────────────────────────
# Start local Redis with: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL="redis://localhost:6379/0"

# ── 4. File & Document Storage ────────────────────────────────────────────────
STORAGE_PROVIDER="local"               # options: 'local', 's3'
STORAGE_LOCAL_DIR="storage_data"

# Optional AWS S3 Configuration:
# AWS_ACCESS_KEY_ID="your_aws_access_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
# AWS_S3_BUCKET="hrms-documents-vault"
# AWS_REGION="ap-south-1"

# ── 5. Authentication & JWT Security ───────────────────────────────────────────
JWT_SECRET_KEY="enterprise_jwt_production_secret_key_hrms_2026_super_secure"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_SALT="hrms_enterprise_api_key_salt_2026"

# ── 6. Multi-Provider AI / LLM Gateway ─────────────────────────────────────────
# The HRMS uses an intelligent failover router across Gemini, Groq, Mistral & Tavily
AI_PRIMARY_PROVIDER="gemini"           # options: 'gemini', 'groq', 'mistral'
AI_SECONDARY_PROVIDER="groq"
AI_DEFAULT_MODEL="gemini-1.5-flash"

# Get your free API keys:
# • Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY="your-gemini-api-key"

# • Groq Cloud Console: https://console.groq.com
GROQ_API_KEY="your-groq-api-key"

# • Mistral AI Console: https://console.mistral.ai
MISTRAL_API_KEY="your-mistral-api-key"

# • Tavily Web Search API (for market salary & benchmark research): https://tavily.com
TAVILY_API_KEY="your-tavily-api-key"

# • HuggingFace Inference API (Optional): https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="your-huggingface-api-key"

# ── 7. Real Google Workspace / Gmail MCP Integration ───────────────────────────
# Enables autonomous candidate interview invites, scorecards & official offer letters
# Read docs/GMAIL_MCP_SETUP_GUIDE.md for step-by-step Google Cloud OAuth2 setup.
GMAIL_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-google-oauth-client-secret"
GMAIL_REFRESH_TOKEN="your-oauth2-refresh-token"
GMAIL_SENDER_EMAIL="your-authorized-sender@gmail.com"  # e.g., 2000nyrasharma@gmail.com
GMAIL_TEST_RECIPIENT="candidate-test@gmail.com"        # e.g., adarshyt1504@gmail.com

# ── 8. Multi-Channel Router & WhatsApp Gateway ────────────────────────────────
# Executive notification numbers (comma-separated if multiple):
CEO_PHONE_NUMBER="+918591133817,+919372267957"
CEO_EMAIL="ceo@enterprise.demo"

# WhatsApp Gateway Provider (options: 'openwa', 'meta', 'twilio')
WHATSAPP_PROVIDER="openwa"
OPENWA_BASE_URL="http://localhost:2785"
OPENWA_API_KEY="hrms-openwa-secret-2026"
OPENWA_SESSION_ID="default"
WHATSAPP_VERIFY_TOKEN="hrms-webhook-verify"

# (Optional) Meta Cloud API settings:
# WHATSAPP_PHONE_NUMBER_ID="your-meta-phone-id"
# WHATSAPP_ACCESS_TOKEN="your-meta-system-user-token"

# ── 9. Azyntrix Talent Suite & MongoDB Cloud ──────────────────────────────────
AZYNTRIX_PORT=5050
AZYNTRIX_API_URL="http://localhost:5050"
AGENT_API_KEY="azyntrix-agent-dev-key-2026"

# MongoDB Atlas URI (Jobs, Candidates, Resumes)
MONGO_CONNECTION_STRING="mongodb+srv://<username>:<password>@cluster0.mongodb.net/azyntrix?retryWrites=true&w=majority"

# ── 10. Supabase & Observability (Optional) ───────────────────────────────────
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL="INFO"
