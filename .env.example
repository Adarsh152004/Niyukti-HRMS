
# ==============================================================================
# PROGRAM 22 — AI-Native HRMS Complete Environment Configuration
# ==============================================================================
# Copy this to .env and fill in your real values.
# NEVER commit .env to Git.
# ==============================================================================

# ── Core Application ──────────────────────────────────────────────────────────
APP_NAME=HRMS Intelligence OS
APP_VERSION=22.0.0
APP_ENV=development
PORT=8000
SECRET_KEY=your-secret-key-min-32-chars-change-this
TENANT_ID=org-apex-01

# ── Database (PostgreSQL 16 + pgvector) ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://hrms_user:hrms_pass@localhost:5432/hrms_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ─────────────────────────────────────────────────────────────────────
# Start: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379

# ── Object Storage ────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# For S3:
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=hrms-documents
# AWS_REGION=ap-south-1

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_SALT=your-api-key-salt-32-chars

# ── AI Providers ──────────────────────────────────────────────────────────────
AI_PRIMARY_PROVIDER=gemini
AI_SECONDARY_PROVIDER=groq
AI_DEFAULT_MODEL=gemini-3.6-flash

GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
MISTRAL_API_KEY=your-mistral-api-key
OPENAI_API_KEY=optional-openai-key

# ── WhatsApp Integration ──────────────────────────────────────────────────────
# Option A: Meta WhatsApp Cloud API (preferred)
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
WHATSAPP_APP_SECRET=your-app-secret-for-signature-verification
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Option B: Twilio WhatsApp
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── CEO Identity ──────────────────────────────────────────────────────────────
CEO_PHONE_NUMBER=+919372267957
CEO_EMAIL=ceo@yourcompany.com

# ── Email Integration ─────────────────────────────────────────────────────────
# Option A: SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=careers@yourcompany.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
CAREERS_EMAIL=careers@yourcompany.com

# Option B: IMAP polling
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=careers@yourcompany.com
IMAP_PASSWORD=your-app-password

# Option C: Gmail OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# ── LinkedIn Integration ──────────────────────────────────────────────────────
# Requires LinkedIn Marketing Developer Platform approval
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://yourcompany.com/api/v1/integrations/linkedin/callback
LINKEDIN_ACCESS_TOKEN=your-access-token
LINKEDIN_ORGANIZATION_ID=your-organization-id

# ── Google Calendar Integration ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourcompany.com/api/v1/integrations/calendar/callback
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_CALENDAR_ID=primary

# ── Observability ─────────────────────────────────────────────────────────────
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=INFO
OTEL_ENABLED=false
